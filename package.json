{
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^25.2.3",
    "concurrently": "^10.0.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev:all": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run server\" \"npm run frontend\"",
    "server": "ts-node-dev src/server.ts",
    "frontend": "npm --prefix frontend run dev",
    "dev": "ts-node-dev src/index.ts",
    "generate": "ts-node src/cli.ts",
    "build": "tsc",
    "build:all": "tsc && npm --prefix frontend run build",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "inquirer": "^8.2.7",
    "openai": "^6.21.0",
    "resend": "^6.9.4"
  }
}
